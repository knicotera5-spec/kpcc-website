function buildChecklist(){
  const el = document.getElementById('checklistItems');
  if(!el) return;
  const done = CHECKLIST.filter(s=>s.done).length;
  const pct = Math.round(done/CHECKLIST.length*100);
  const bar = document.getElementById('checklistBar');
  const pctEl = document.getElementById('checklistPct');
  const prog = document.getElementById('checklistProgress');
  if(bar) bar.style.width = pct+'%';
  if(pctEl) pctEl.textContent = pct+'%';
  if(prog) prog.textContent = done===CHECKLIST.length ? done+' of '+CHECKLIST.length+' complete — you\'re all set! 🎉' : done+' of '+CHECKLIST.length+' complete — let\'s get you set up';

  el.innerHTML = CHECKLIST.map(function(step,i){
    var badgeHtml = !step.done ? '<span style="font-size:9px;color:var(--text4);font-family:var(--mono)">'+step.badge+'</span>' : '';
    var clickHandler = step.done ? '' : 'CHECKLIST['+i+'].action()';
    return '<div class="cl-item '+(step.done?'done':'')+'" onclick="'+clickHandler+'">'+
      '<div class="cl-check"><svg viewBox="0 0 10 10" fill="none" stroke="#fff" stroke-width="2"><path d="M1.5 5l2.5 2.5 4.5-4"/></svg></div>'+
      '<div style="flex:1"><div class="cl-title">'+step.title+'</div><div class="cl-desc">'+step.desc+'</div></div>'+
      '<div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0">'+
      '<span style="font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;background:'+productColors[step.product]+'30;color:'+productColors[step.product]+';font-family:var(--mono)">'+productLabels[step.product]+'</span>'+
      badgeHtml+'</div></div>';
  }).join('');
}

