async function doLogin() {
  const emailEl = document.getElementById('loginEmail');
  const passEl = document.getElementById('loginPass');
  const errEl = document.getElementById('loginErr');
  const btnEl = document.getElementById('loginBtn');

  if(!emailEl || !passEl) return;

  const email = emailEl.value.trim().toLowerCase();
  const pass = passEl.value.trim();

  if(errEl) errEl.textContent = '';
  if(!email || !pass) {
    if(errEl) errEl.textContent = 'Please enter your email and password.';
    return;
  }

  if(btnEl) { btnEl.textContent = 'Signing in...'; btnEl.disabled = true; }

  // Try Supabase first
  try {
    if (!sb) throw new Error('Supabase not available');
    const { data, error } = await sb.auth.signInWithPassword({ email, password: pass });
    if(!error && data.user) {
      const { data: userSchool } = await sb.from('school_users')
        .select('schools(*)')
        .eq('user_id', data.user.id)
        .single();
      const school = userSchool?.schools;
      currentUser = {
        email: data.user.email,
        school: school?.name || data.user.email.split('@')[0],
        initials: (school?.name || 'SC').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase(),
        access: school?.access || ['hub'],
        role: school?.role || 'School Admin',
        schoolId: school?.id
      };
      if(btnEl) { btnEl.textContent = 'Sign In →'; btnEl.disabled = false; }
      launchDashboard();
      return;
    }
  } catch(e) { /* fall through to fallback */ }

  // Fallback demo accounts
  const DEMO = {
    'demo@school.org':          { password:'trial2026',  school:'Demo Charter School', initials:'DC', role:'School Admin', access:['hub','enroll','scholars'] },
    'info@fwsteamacademy.org':  { password:'fwsteam25',  school:'Fort Worth STEAM Academy', initials:'FW', role:'School Admin', access:['hub','enroll','scholars'] },
    'kristina@kpcharterkollective.com': { password:'kpck2025', school:'KP Charter Kollective', initials:'KP', role:'Admin', access:['hub','enroll','scholars'] },
    'mcapehart@xstreammindsacademy.com': { password:'xstreamminds2026', school:'Xstream Minds Academy', initials:'XM', role:'School Admin', access:['hub','enroll','scholars'] }
  };

  const acct = DEMO[email];
  if(acct && acct.password === pass) {
    currentUser = { email, ...acct };
    if(btnEl) { btnEl.textContent = 'Sign In →'; btnEl.disabled = false; }
    launchDashboard();
    return;
  }

  if(errEl) errEl.textContent = 'Email or password is incorrect.';
  if(btnEl) { btnEl.textContent = 'Sign In →'; btnEl.disabled = false; }
}

