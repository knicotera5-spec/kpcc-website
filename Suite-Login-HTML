<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign In — KPCC Suite</title>
<meta http-equiv="refresh" content="0;u<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My School Dashboard — KP Charter Kollective</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
:root{
  --navy:#0b1f3d;--navy-mid:#132a52;--navy-lt:#1d3a6b;
  --orange:#f55a1e;--orange-lt:#ff7040;--orange-dim:rgba(245,90,30,.1);
  --teal:#0891b2;--teal-lt:#06b6d4;--teal-dim:rgba(8,145,178,.1);
  --green:#059669;--green-dim:rgba(5,150,105,.1);
  --amber:#d97706;--amber-dim:rgba(217,119,6,.1);
  --purple:#7c3aed;--purple-dim:rgba(124,58,237,.1);
  --indigo:#4338ca;--indigo-lt:#6366f1;--indigo-dim:rgba(67,56,202,.1);
  --red:#dc2626;--red-dim:rgba(220,38,38,.1);
  --bg:#f1f4f9;--surface:#fff;
  --border:#dde3ee;--border2:#c8d0e0;
  --text:#0b1f3d;--text2:#3d5068;--text3:#7a8fa6;--text4:#b0bfcf;
  --serif:'Instrument Serif',Georgia,serif;
  --sans:'Geist',system-ui,sans-serif;
  --mono:'Geist Mono',monospace;
  --shadow-sm:0 1px 3px rgba(11,31,61,.06);
  --shadow-md:0 4px 12px rgba(11,31,61,.08);
  --shadow-lg:0 16px 48px rgba(11,31,61,.14);
  --r:8px;--rl:12px;--rxl:16px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{-webkit-font-smoothing:antialiased}
body{font-family:var(--sans);background:var(--bg);color:var(--text);min-height:100vh;display:flex;overflow:hidden}

/* ── LOGIN ── */
.login-wrap{position:fixed;inset:0;background:var(--navy);display:flex;align-items:center;justify-content:center;z-index:1000;transition:opacity .4s,visibility .4s}
.login-wrap.gone{opacity:0;visibility:hidden;pointer-events:none}
.login-bg{position:absolute;inset:0;overflow:hidden}
.login-bg::before{content:'';position:absolute;top:-30%;left:-15%;width:600px;height:600px;background:radial-gradient(circle,rgba(245,90,30,.1) 0%,transparent 60%);animation:bgp 8s ease-in-out infinite}
.login-bg::after{content:'';position:absolute;bottom:-20%;right:-10%;width:500px;height:500px;background:radial-gradient(circle,rgba(8,145,178,.08) 0%,transparent 60%);animation:bgp 10s ease-in-out infinite reverse}
@keyframes bgp{0%,100%{transform:scale(1)}50%{transform:scale(1.2)}}
.login-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:44px;width:440px;max-width:95vw;position:relative;z-index:2;backdrop-filter:blur(20px)}
.login-logo{display:flex;align-items:center;gap:12px;margin-bottom:28px}
.login-logo-mark{width:40px;height:40px;background:linear-gradient(135deg,var(--orange),var(--orange-lt));border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:18px;color:#fff;font-weight:700}
.login-logo-text{font-family:var(--serif);font-size:20px;color:#fff}
.login-logo-text span{display:block;font-family:var(--mono);font-size:9px;color:rgba(255,255,255,.3);letter-spacing:.1em;text-transform:uppercase;margin-top:2px}
.login-h{font-family:var(--serif);font-size:26px;color:#fff;margin-bottom:5px}
.login-sub{font-size:13px;color:rgba(255,255,255,.4);margin-bottom:28px}
.lbl{display:block;font-size:11px;font-weight:500;color:rgba(255,255,255,.45);letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px;font-family:var(--mono)}
.linp{width:100%;padding:12px 14px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:var(--r);font-size:14px;font-family:var(--sans);color:#fff;outline:none;transition:border-color .15s;margin-bottom:14px}
.linp::placeholder{color:rgba(255,255,255,.2)}
.linp:focus{border-color:var(--orange);box-shadow:0 0 0 3px var(--orange-dim)}
.login-btn{width:100%;padding:13px;background:var(--orange);border:none;border-radius:var(--r);font-size:14px;font-weight:600;color:#fff;cursor:pointer;font-family:var(--sans);transition:all .15s}
.login-btn:hover{background:var(--orange-lt);transform:translateY(-1px);box-shadow:0 4px 14px rgba(245,90,30,.35)}
.login-err{color:#fca5a5;font-size:12px;margin-top:8px;min-height:18px}
.login-footer{text-align:center;margin-top:20px;font-size:12px;color:rgba(255,255,255,.2)}

/* ── SHELL ── */
.shell{display:flex;width:100%;height:100vh;overflow:hidden}

/* ── SIDEBAR ── */
.sidebar{width:240px;min-width:240px;background:var(--navy);display:flex;flex-direction:column;height:100vh;overflow:hidden;transition:width .2s}
.sb-top{padding:18px 14px 16px;border-bottom:1px solid rgba(255,255,255,.06)}
.sb-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.sb-logo-mark{width:32px;height:32px;background:linear-gradient(135deg,var(--orange),var(--orange-lt));border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:14px;color:#fff;font-weight:700;flex-shrink:0}
.sb-logo-text{font-family:var(--serif);font-size:15px;color:#fff;line-height:1}
.sb-logo-text span{display:block;font-family:var(--mono);font-size:9px;color:rgba(255,255,255,.25);letter-spacing:.08em;text-transform:uppercase;margin-top:2px}
.sb-school{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:var(--r);padding:9px 12px;display:flex;align-items:center;justify-content:space-between}
.sb-school-name{font-size:12px;font-weight:600;color:#fff}
.sb-school-yr{font-size:10px;color:rgba(255,255,255,.3);margin-top:1px}

/* PRODUCT SWITCHER */
.product-switcher{padding:10px 8px;border-bottom:1px solid rgba(255,255,255,.06)}
.ps-label{font-family:var(--mono);font-size:9px;font-weight:500;color:rgba(255,255,255,.22);letter-spacing:.12em;text-transform:uppercase;padding:0 8px 6px}
.ps-btn{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;cursor:pointer;transition:all .12s;margin-bottom:3px;border:1px solid transparent;position:relative}
.ps-btn:hover{background:rgba(255,255,255,.05)}
.ps-btn.active{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.1)}
.ps-btn.locked{opacity:.55;cursor:pointer}
.ps-icon{width:28px;height:28px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:11px;font-weight:700;color:#fff;flex-shrink:0}
.ps-icon-hub{background:linear-gradient(135deg,var(--orange),var(--orange-lt))}
.ps-icon-enroll{background:linear-gradient(135deg,var(--teal),var(--teal-lt))}
.ps-icon-scholars{background:linear-gradient(135deg,var(--indigo),var(--indigo-lt))}
.ps-name{font-size:13px;font-weight:600;color:rgba(255,255,255,.8);flex:1}
.ps-sub{font-size:10px;color:rgba(255,255,255,.3);margin-top:1px}
.ps-active-dot{width:6px;height:6px;border-radius:50%;background:var(--green);flex-shrink:0}
.ps-lock{width:18px;height:18px;border-radius:5px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ps-lock svg{width:10px;height:10px;color:rgba(255,255,255,.3)}

/* NAV */
.sb-nav{padding:8px 8px;flex:1;overflow-y:auto}
.sb-nav::-webkit-scrollbar{display:none}
.nav-grp{font-family:var(--mono);font-size:9px;font-weight:500;color:rgba(255,255,255,.22);letter-spacing:.12em;text-transform:uppercase;padding:10px 8px 5px}
.nav-item{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:7px;font-size:13px;font-weight:500;color:rgba(255,255,255,.45);cursor:pointer;transition:all .12s;margin-bottom:1px;border:1px solid transparent}
.nav-item:hover{background:rgba(255,255,255,.05);color:rgba(255,255,255,.8)}
.nav-item.active{border-color:rgba(255,255,255,.1)}
.nav-item.active.hub{background:rgba(245,90,30,.14);color:var(--orange-lt);border-color:rgba(245,90,30,.2)}
.nav-item.active.enroll{background:rgba(8,145,178,.14);color:var(--teal-lt);border-color:rgba(8,145,178,.2)}
.nav-item.active.scholars{background:rgba(67,56,202,.14);color:var(--indigo-lt);border-color:rgba(67,56,202,.2)}
.nav-item svg{width:15px;height:15px;flex-shrink:0}
.nav-badge{margin-left:auto;background:var(--orange);color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:20px;font-family:var(--mono)}
.nav-badge.green{background:var(--green)}
.nav-badge.teal{background:var(--teal)}
.sb-foot{padding:12px 8px;border-top:1px solid rgba(255,255,255,.06);display:flex;align-items:center;gap:9px}
.sb-av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--orange),var(--orange-lt));display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0;font-family:var(--mono)}
.sb-uname{font-size:12px;font-weight:600;color:rgba(255,255,255,.75)}
.sb-urole{font-size:10px;color:rgba(255,255,255,.3)}
.icon-btn{width:26px;height:26px;border-radius:5px;border:none;background:none;color:rgba(255,255,255,.3);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .12s;margin-left:auto}
.icon-btn:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.7)}
.icon-btn svg{width:13px;height:13px}

/* ── MAIN ── */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.topbar{background:var(--surface);border-bottom:1px solid var(--border);padding:0 28px;height:54px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;z-index:50}
.tb-left{display:flex;align-items:center;gap:10px}
.tb-product-pill{display:flex;align-items:center;gap:7px;padding:4px 12px 4px 6px;border-radius:99px;font-size:12px;font-weight:600;font-family:var(--mono)}
.tp-hub{background:var(--orange-dim);color:var(--orange)}
.tp-enroll{background:var(--teal-dim);color:var(--teal)}
.tp-scholars{background:var(--indigo-dim);color:var(--indigo)}
.tp-home{background:var(--bg);color:var(--text3);border:1px solid var(--border)}
.tb-product-pill-icon{width:18px;height:18px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:8px;font-weight:800;color:#fff}
.tpi-hub{background:var(--orange)}
.tpi-enroll{background:var(--teal)}
.tpi-scholars{background:var(--indigo)}
.tb-sep{color:var(--text4);font-size:12px}
.tb-crumb{font-size:13px;color:var(--text3)}
.tb-crumb.active{font-weight:600;color:var(--text)}
.tb-right{display:flex;align-items:center;gap:8px}
.tb-search{display:flex;align-items:center;gap:7px;background:var(--bg);border:1px solid var(--border);border-radius:var(--r);padding:6px 12px;width:200px}
.tb-search input{background:none;border:none;outline:none;font-size:13px;font-family:var(--sans);color:var(--text);flex:1}
.tb-search input::placeholder{color:var(--text4)}
.tb-search svg{color:var(--text4);width:13px;height:13px;flex-shrink:0}
.notif-btn{width:32px;height:32px;border-radius:var(--r);background:var(--bg);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative}
.notif-btn svg{width:15px;height:15px;color:var(--text3)}
.notif-dot{position:absolute;top:6px;right:6px;width:6px;height:6px;background:var(--orange);border-radius:50%;border:1.5px solid var(--surface)}
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:var(--r);font-size:13px;font-weight:500;cursor:pointer;border:1px solid transparent;font-family:var(--sans);transition:all .12s;white-space:nowrap}
.btn svg{width:13px;height:13px}
.btn-primary{background:var(--orange);color:#fff;border-color:var(--orange)}
.btn-primary:hover{background:var(--orange-lt)}
.btn-primary-teal{background:var(--teal);color:#fff;border-color:var(--teal)}
.btn-primary-teal:hover{background:var(--teal-lt)}
.btn-primary-indigo{background:var(--indigo);color:#fff;border-color:var(--indigo)}
.btn-secondary{background:var(--surface);color:var(--text2);border-color:var(--border)}
.btn-secondary:hover{background:var(--bg);border-color:var(--border2)}
.btn-ghost{background:none;color:var(--text3);border-color:transparent}
.btn-ghost:hover{background:var(--bg);color:var(--text2)}
.btn-sm{padding:5px 10px;font-size:12px}

/* ── CONTENT ── */
.content{flex:1;overflow-y:auto;padding:24px 28px}
.content::-webkit-scrollbar{width:4px}
.content::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}
.product-view{display:none}
.product-view.active{display:block}
.sub-view{display:none}
.sub-view.active{display:block}
.page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:24px}
.page-title{font-family:var(--serif);font-size:26px;color:var(--text);line-height:1.2;margin-bottom:3px}
.page-title em{font-style:italic}
.page-title.hub-em em{color:var(--orange)}
.page-title.enroll-em em{color:var(--teal)}
.page-title.scholars-em em{color:var(--indigo)}
.page-sub{font-size:13px;color:var(--text3)}
.page-actions{display:flex;gap:8px;align-items:center}

/* ONBOARDING */
.onboarding-modal{width:560px}
.ob-hero{background:linear-gradient(135deg,var(--navy),var(--navy-lt));padding:32px;border-radius:var(--rl) var(--rl) 0 0;text-align:center;position:relative;overflow:hidden}
.ob-hero::before{content:'';position:absolute;top:-30px;right:-30px;width:160px;height:160px;border-radius:50%;border:1px solid rgba(255,255,255,.06)}
.ob-step{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--border);cursor:pointer;transition:all .12s}
.ob-step:last-child{border-bottom:none}
.ob-step:hover{background:var(--bg);margin:0 -20px;padding-left:20px;padding-right:20px;border-radius:var(--r)}
.ob-step-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ob-step-num{width:36px;height:36px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--text4);flex-shrink:0;font-family:var(--mono);transition:all .2s}
.ob-step.done .ob-step-num{background:var(--green);border-color:var(--green);color:#fff}
.ob-step.active .ob-step-num{border-color:var(--teal);color:var(--teal)}
.ob-step-title{font-size:13px;font-weight:600;color:var(--text);margin-bottom:3px;line-height:1.3}
.ob-step.done .ob-step-title{color:var(--text3);text-decoration:line-through}
.ob-step-desc{font-size:12px;color:var(--text3);line-height:1.5}
.ob-progress-bar{height:6px;background:var(--border);border-radius:3px;overflow:hidden;margin-bottom:6px}
.ob-progress-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--teal),var(--teal-lt));transition:width .4s}
.checklist-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--rl);overflow:hidden;margin-bottom:16px}
.cl-item{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .12s}
.cl-item:last-child{border-bottom:none}
.cl-item:hover{background:var(--bg)}
.cl-check{width:20px;height:20px;border-radius:50%;border:2px solid var(--border2);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;transition:all .2s}
.cl-item.done .cl-check{background:var(--green);border-color:var(--green)}
.cl-item.done .cl-check svg{display:block}
.cl-check svg{display:none;width:10px;height:10px}
.cl-item.done .cl-title{color:var(--text3);text-decoration:line-through}
.cl-title{font-size:13px;font-weight:600;color:var(--text);margin-bottom:2px}
.cl-desc{font-size:12px;color:var(--text3);line-height:1.5}
.cl-badge{font-size:10px;font-weight:600;padding:1px 7px;border-radius:4px;font-family:var(--mono);margin-left:auto;flex-shrink:0;margin-top:2px}
/* HOME DASHBOARD */
.home-welcome{background:linear-gradient(135deg,var(--navy),var(--navy-lt));border-radius:var(--rxl);padding:32px 36px;margin-bottom:20px;position:relative;overflow:hidden}
.home-welcome::before{content:'';position:absolute;top:-40px;right:-40px;width:200px;height:200px;border-radius:50%;border:1px solid rgba(255,255,255,.05)}
.home-welcome::after{content:'';position:absolute;bottom:-60px;left:-20px;width:160px;height:160px;border-radius:50%;border:1px solid rgba(255,255,255,.04)}
.hw-greeting{font-family:var(--serif);font-size:28px;color:#fff;margin-bottom:6px;position:relative;z-index:1}
.hw-greeting em{color:var(--orange-lt);font-style:italic}
.hw-sub{font-size:13px;color:rgba(255,255,255,.45);position:relative;z-index:1}
.home-products{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px}
.hp-card{border-radius:var(--rxl);padding:24px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden}
.hp-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.hp-card.locked{cursor:pointer;filter:none}
.hp-hub{background:linear-gradient(135deg,var(--navy),var(--navy-lt));border:1px solid rgba(245,90,30,.2)}
.hp-enroll{background:linear-gradient(135deg,#065f46,#059669);border:1px solid rgba(8,145,178,.2)}
.hp-scholars{background:linear-gradient(135deg,#1e1b4b,#312e81);border:1px solid rgba(67,56,202,.2)}
.hp-card-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:16px;font-weight:700;color:#fff;margin-bottom:14px;position:relative;z-index:1}
.hp-icon-hub{background:linear-gradient(135deg,var(--orange),var(--orange-lt))}
.hp-icon-enroll{background:linear-gradient(135deg,var(--teal),var(--teal-lt))}
.hp-icon-scholars{background:linear-gradient(135deg,var(--indigo),var(--indigo-lt))}
.hp-card-name{font-size:16px;font-weight:700;color:#fff;margin-bottom:4px;position:relative;z-index:1}
.hp-card-desc{font-size:12px;color:rgba(255,255,255,.5);line-height:1.55;position:relative;z-index:1}
.hp-card-footer{display:flex;align-items:center;justify-content:space-between;margin-top:16px;position:relative;z-index:1}
.hp-card-stat{font-family:var(--mono);font-size:11px;color:rgba(255,255,255,.4)}
.hp-card-arrow{font-size:14px;color:rgba(255,255,255,.4);transition:all .15s}
.hp-card:hover .hp-card-arrow{color:#fff;transform:translateX(3px)}
.hp-lock-badge{position:absolute;top:12px;right:12px;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.15);border-radius:6px;padding:3px 8px;display:flex;align-items:center;gap:4px;font-size:10px;font-weight:600;color:rgba(255,255,255,.5);font-family:var(--mono)}
.hp-lock-badge svg{width:10px;height:10px}
.hp-free-badge{position:absolute;top:12px;right:12px;background:rgba(5,150,105,.2);border:1px solid rgba(5,150,105,.3);border-radius:6px;padding:3px 8px;font-size:10px;font-weight:700;color:#6ee7b7;font-family:var(--mono)}

/* CARDS */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--rl);overflow:hidden}
.card-head{padding:14px 20px 12px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.card-title{font-size:14px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:8px}
.card-dot{width:7px;height:7px;border-radius:50%}
.card-sub{font-size:12px;color:var(--text3);margin-top:1px}
.card-body{padding:20px}
.tab-row{display:flex;gap:2px;background:var(--bg);border-radius:7px;padding:3px}
.tab{padding:5px 12px;border-radius:5px;font-size:12px;font-weight:500;color:var(--text3);cursor:pointer;transition:all .12s}
.tab.active{background:var(--surface);color:var(--text);box-shadow:var(--shadow-sm)}

/* KPI ROW */
.kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:var(--rl);padding:16px 18px;transition:all .15s;position:relative;overflow:hidden}
.kpi:hover{border-color:var(--border2);box-shadow:var(--shadow-md)}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.kpi.k-orange::before{background:var(--orange)}
.kpi.k-teal::before{background:var(--teal)}
.kpi.k-green::before{background:var(--green)}
.kpi.k-purple::before{background:var(--purple)}
.kpi.k-indigo::before{background:var(--indigo)}
.kpi.k-amber::before{background:var(--amber)}
.kpi-label{font-size:10px;font-weight:600;color:var(--text3);letter-spacing:.07em;text-transform:uppercase;margin-bottom:8px;font-family:var(--mono)}
.kpi-value{font-family:var(--serif);font-size:30px;color:var(--text);line-height:1;margin-bottom:5px}
.kpi-change{font-size:11px;font-weight:600;color:var(--green);display:flex;align-items:center;gap:3px}
.kpi-change svg{width:11px;height:11px}
.kpi-change.warn{color:var(--amber)}

/* CHART */
.chart-wrap{position:relative;height:200px}

/* TABLE */
.data-table{width:100%;border-collapse:collapse}
.data-table th{padding:9px 14px;text-align:left;font-size:10px;font-weight:700;color:var(--text3);letter-spacing:.07em;text-transform:uppercase;background:var(--bg);border-bottom:1px solid var(--border);font-family:var(--mono)}
.data-table td{padding:11px 14px;border-bottom:1px solid var(--border);font-size:13px;color:var(--text2)}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:var(--bg);cursor:pointer}

/* PILLS / BADGES */
.status-pill{font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;font-family:var(--mono)}
.sp-green{background:var(--green-dim);color:var(--green)}
.sp-teal{background:var(--teal-dim);color:var(--teal)}
.sp-amber{background:var(--amber-dim);color:var(--amber)}
.sp-red{background:var(--red-dim);color:var(--red)}
.sp-purple{background:var(--purple-dim);color:var(--purple)}
.sp-indigo{background:var(--indigo-dim);color:var(--indigo)}
.grade-pill{font-size:11px;font-weight:700;padding:2px 9px;border-radius:5px;font-family:var(--mono)}
.gp-a{background:#f0fdf4;color:#166534}
.gp-b{background:#eff6ff;color:#1e40af}
.gp-c{background:#fffbeb;color:#92400e}
.gp-d{background:#fff7ed;color:#9a3412}
.gp-f{background:var(--red-dim);color:var(--red)}
.av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0;font-family:var(--mono)}

/* PIPELINE */
.pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:16px}
.pipeline-col{background:var(--bg);border-radius:var(--rl);padding:12px;min-height:200px}
.pipeline-col-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.pipeline-col-name{font-size:11px;font-weight:700;color:var(--text2);font-family:var(--mono);letter-spacing:.05em;text-transform:uppercase}
.pipeline-col-count{font-size:10px;font-weight:700;padding:1px 6px;border-radius:4px;font-family:var(--mono)}
.family-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:10px;margin-bottom:8px;cursor:pointer;transition:all .12s}
.family-card:hover{border-color:var(--border2);box-shadow:var(--shadow-sm)}
.fc-name{font-size:12px;font-weight:600;color:var(--text);margin-bottom:3px}
.fc-meta{font-size:10px;color:var(--text3);font-family:var(--mono)}
.fc-tags{display:flex;gap:4px;margin-top:5px;flex-wrap:wrap}
.fc-tag{font-size:9px;font-weight:600;padding:1px 5px;border-radius:3px;font-family:var(--mono)}

/* CAL */
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal-day-label{text-align:center;font-size:9px;font-weight:600;color:var(--text4);font-family:var(--mono);padding:5px 0;letter-spacing:.06em;text-transform:uppercase}
.cal-day{min-height:70px;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:5px;cursor:pointer;transition:all .12s}
.cal-day:hover{border-color:var(--border2)}
.cal-day.today{border-color:var(--orange);background:#fffaf8}
.cal-day.other{background:transparent;border-color:transparent}
.cal-date{font-size:10px;font-weight:600;color:var(--text2);margin-bottom:3px;font-family:var(--mono)}
.cal-today-dot{width:16px;height:16px;border-radius:50%;background:var(--orange);display:flex;align-items:center;justify-content:center;margin-bottom:3px}
.cal-today-dot span{font-size:9px;font-weight:700;color:#fff;font-family:var(--mono)}
.cal-post{font-size:8px;font-weight:600;padding:1px 4px;border-radius:2px;margin-bottom:2px}
.cp-ig{background:#fce4ed;color:#b5234f}
.cp-fb{background:#deeafc;color:#1555c4}
.cp-email{background:var(--teal-dim);color:var(--teal)}
.cp-sms{background:var(--orange-dim);color:var(--orange)}

/* POST LIST */
.post-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--rl);padding:12px 16px;display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;transition:all .12s;cursor:pointer;margin-bottom:8px}
.post-item:hover{border-color:var(--border2);box-shadow:var(--shadow-sm)}
.post-icon{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.post-icon svg{width:16px;height:16px}
.pi-ig{background:#fce4ed;color:#b5234f}
.pi-fb{background:#deeafc;color:#1555c4}
.pi-email{background:var(--teal-dim);color:var(--teal)}
.pi-sms{background:var(--orange-dim);color:var(--orange)}
.post-title{font-size:13px;font-weight:600;color:var(--text);margin-bottom:2px}
.post-preview{font-size:12px;color:var(--text3);display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.post-meta{display:flex;align-items:center;gap:8px;margin-top:4px}
.post-time{font-size:10px;color:var(--text4);font-family:var(--mono)}

/* ATTENDANCE CAL */
.att-cell{aspect-ratio:1;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;font-family:var(--mono);cursor:pointer;border:1px solid transparent}
.att-p{background:var(--green-dim);color:var(--green);border-color:rgba(5,150,105,.2)}
.att-a{background:var(--red-dim);color:var(--red);border-color:rgba(220,38,38,.2)}
.att-t{background:var(--amber-dim);color:var(--amber);border-color:rgba(217,119,6,.2)}
.att-w{background:var(--bg);color:var(--text4)}
.att-f{background:transparent;color:var(--text4);border-color:var(--border)}
.att-today{box-shadow:0 0 0 2px var(--teal)}

/* LESSON */
.lesson-week{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.lesson-day{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);overflow:hidden}
.lesson-day-head{padding:8px 10px;background:var(--bg);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.lesson-day-name{font-size:10px;font-weight:700;color:var(--text2);font-family:var(--mono);letter-spacing:.06em;text-transform:uppercase}
.lesson-day.today-col .lesson-day-head{background:var(--teal-dim);border-color:rgba(8,145,178,.2)}
.lesson-day.today-col .lesson-day-name{color:var(--teal)}
.lb{padding:7px 9px;border-bottom:1px solid var(--border);cursor:pointer}
.lb:last-child{border-bottom:none}
.lb:hover{background:var(--bg)}
.lb-subj{font-size:9px;font-weight:700;padding:1px 5px;border-radius:3px;margin-bottom:3px;display:inline-block;font-family:var(--mono)}
.lb-reading{background:#fce4ed;color:#b5234f}
.lb-math{background:#deeafc;color:#1555c4}
.lb-science{background:var(--green-dim);color:var(--green)}
.lb-writing{background:var(--purple-dim);color:var(--purple)}
.lb-advisory{background:var(--amber-dim);color:var(--amber)}
.lb-title{font-size:11px;font-weight:600;color:var(--text);line-height:1.3}
.lb-std{font-size:9px;color:var(--text4);font-family:var(--mono)}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(11,31,61,.5);z-index:400;display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;transition:all .2s;backdrop-filter:blur(4px)}
.modal-overlay.open{opacity:1;visibility:visible}
.modal{background:var(--surface);border-radius:var(--rxl);width:520px;max-width:95vw;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-lg);transform:translateY(12px) scale(.98);transition:transform .2s}
.modal-overlay.open .modal{transform:none}
.modal-head{padding:20px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.modal-title{font-size:16px;font-weight:700;color:var(--text)}
.modal-close{width:28px;height:28px;border-radius:6px;border:1px solid var(--border);background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text3)}
.modal-close svg{width:14px;height:14px}
.modal-body{padding:20px 24px}
.modal-foot{padding:16px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px}

/* UPGRADE MODAL */
.upgrade-modal{width:480px}
.upgrade-hero{background:linear-gradient(135deg,var(--navy),var(--navy-lt));padding:28px;border-radius:var(--rl) var(--rl) 0 0;position:relative;overflow:hidden;text-align:center}
.upgrade-hero::before{content:'';position:absolute;top:-30px;right:-30px;width:140px;height:140px;border-radius:50%;border:1px solid rgba(255,255,255,.06)}
.upgrade-lock-icon{width:52px;height:52px;border-radius:14px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;position:relative;z-index:1}
.upgrade-lock-icon svg{width:24px;height:24px;color:rgba(255,255,255,.7)}
.upgrade-title{font-family:var(--serif);font-size:22px;color:#fff;margin-bottom:6px;position:relative;z-index:1}
.upgrade-sub{font-size:13px;color:rgba(255,255,255,.45);position:relative;z-index:1}
.upgrade-body{padding:24px}
.upgrade-features{display:flex;flex-direction:column;gap:10px;margin-bottom:20px}
.uf-item{display:flex;align-items:flex-start;gap:10px}
.uf-check{width:18px;height:18px;border-radius:50%;background:var(--green-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.uf-check svg{width:10px;height:10px;color:var(--green)}
.uf-text{font-size:13px;color:var(--text2);line-height:1.5}
.upgrade-price{background:var(--bg);border-radius:var(--r);padding:14px 16px;text-align:center;margin-bottom:16px}
.up-from{font-size:11px;color:var(--text3);margin-bottom:4px;font-family:var(--mono)}
.up-price{font-family:var(--serif);font-size:28px;color:var(--text)}
.up-per{font-size:13px;color:var(--text3)}

/* FORM */
.fgrp{display:flex;flex-direction:column;gap:5px;margin-bottom:14px}
.flbl{font-size:11px;font-weight:600;color:var(--text2);font-family:var(--mono);letter-spacing:.03em;text-transform:uppercase}
.finp,.fsel,.ftxt{padding:9px 12px;border:1px solid var(--border);border-radius:var(--r);font-size:13px;font-family:var(--sans);color:var(--text);outline:none;transition:all .15s;background:var(--surface);width:100%}
.finp:focus,.fsel:focus,.ftxt:focus{border-color:var(--teal);box-shadow:0 0 0 3px var(--teal-dim)}
.ftxt{resize:vertical;min-height:80px;line-height:1.6}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* TOAST */
.toast-wrap{position:fixed;bottom:24px;right:24px;z-index:999;display:flex;flex-direction:column;gap:8px;pointer-events:none}
.toast{background:var(--navy);color:#fff;padding:12px 16px;border-radius:var(--r);font-size:13px;font-weight:500;box-shadow:var(--shadow-lg);display:flex;align-items:center;gap:10px;transform:translateY(20px);opacity:0;transition:all .25s;max-width:320px}
.toast.show{transform:none;opacity:1}
.toast-icon{width:20px;height:20px;border-radius:50%;background:var(--green-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.toast-icon svg{color:var(--green);width:11px;height:11px}

@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.fade-in{animation:fadeIn .3s ease both}
</style>
</head>
