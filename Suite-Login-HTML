  badge.style.display='flex';
  document.getElementById('filePreviewName').textContent=file.name;
  document.getElementById('fileUploadArea').style.borderColor='var(--teal)';
}

function buildMappingRows(){
  const rows=document.getElementById('fieldMappingRows');
  rows.innerHTML=sampleColumns.map((col,i)=>`
    <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;margin-bottom:8px">
      <div style="padding:8px 12px;background:var(--bg);border:1px solid var(--border);border-radius:var(--r);font-size:13px;color:var(--text2);font-family:var(--mono)">${col}</div>
      <svg viewBox="0 0 14 14" fill="none" stroke="var(--teal)" stroke-width="1.5" style="width:14px;height:14px"><path d="M3 7h8M7 3l4 4-4 4"/></svg>
      <select class="fsel" style="font-size:12px;padding:7px 10px">
        ${fieldOptions.map(opt=>`<option ${autoMap[col]===opt?'selected':''}>${opt}</option>`).join('')}
      </select>
    </div>`).join('');
}

function wizardNext(){
  if(wizardStep===1){
    const hasFile = selectedFile || (importType==='sheets' && document.getElementById('sheetsUrl').value.trim());
    if(!hasFile){showToast('Please select a file or paste a Google Sheets URL');return;}
    wizardStep=2;
    buildMappingRows();
  } else if(wizardStep===2){
    wizardStep=3;
  } else if(wizardStep===3){
    // Simulate import
    closeImportWizard();
    showToast('24 families imported successfully into your pipeline!');
    switchSubView('enroll','pipeline');
    return;
  }
  updateWizardStep();
}
function wizardBack(){
  if(wizardStep>1) wizardStep--;
  updateWizardStep();
}
function updateWizardStep(){
  document.getElementById('wizStep1').style.display=wizardStep===1?'':'none';
  document.getElementById('wizStep2').style.display=wizardStep===2?'':'none';
  document.getElementById('wizStep3').style.display=wizardStep===3?'':'none';
  document.getElementById('wizBackBtn').style.display=wizardStep>1?'':'none';
  const nextBtn=document.getElementById('wizNextBtn');
  const titles=['Import Families — Step 1 of 3','Map Your Columns — Step 2 of 3','Preview & Import — Step 3 of 3'];
  const subs=['Choose your file or paste a Google Sheets link','Review the auto-detected field mapping','Everything looks good — ready to import'];
  const nextLabels=['Continue → Map Fields','Continue → Preview','Import 24 Families →'];
  document.getElementById('wizardTitle').textContent=titles[wizardStep-1];
  document.getElementById('wizardSub').textContent=subs[wizardStep-1];
  nextBtn.textContent=nextLabels[wizardStep-1];
  // Update step indicators
  [1,2,3].forEach(s=>{
    const circle=document.getElementById(s===1?null:`step${s}circle`);
    const label=document.getElementById(s===1?null:`step${s}label`);
    if(!circle)return;
    if(s<=wizardStep){circle.style.background='var(--teal)';circle.style.color='#fff';circle.style.border='none';if(label)label.style.color='var(--teal)';}
    else{circle.style.background='var(--bg)';circle.style.color='var(--text4)';circle.style.border='1px solid var(--border)';if(label)label.style.color='var(--text4)';}
  });
}

function showToast(msg){const t=document.getElementById('toast');document.getElementById('toastMsg').textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000)}
</script>

