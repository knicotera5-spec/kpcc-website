function handleProductClick(product){
  if(currentUser.access.includes(product)){
    switchProduct(product);
  } else {
    showUpgradeModal(product);
  }
}

function switchProduct(product){
  currentProduct = product;
  document.querySelectorAll('.product-view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+product).classList.add('active');
  document.querySelectorAll('.ps-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('ps'+product.charAt(0).toUpperCase()+product.slice(1)).classList.add('active');
  if(product==='home') document.getElementById('psHome').classList.add('active');
  // reset to default sub view
  const defaultSub = product === 'home' ? 'dashboard' : 'dashboard';
  switchSubView(product, defaultSub);
  buildNav(product);
  updateTopbar(product, defaultSub);
  // init charts
  if(!chartsInited[product]){
    chartsInited[product]=true;
    setTimeout(()=>initCharts(product),80);
  }
  if(product==='enroll') buildEnrollData();
  if(product==='scholars') buildScholarsData();
}

function switchSubView(product, view){
  currentSubView = view;
  document.querySelectorAll(`#view-${product} .sub-view`).forEach(v=>v.classList.remove('active'));
  const el = document.getElementById(`${product}-${view}`);
  if(el) el.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const navEl = document.getElementById(`nav-${product}-${view}`);
  if(navEl) navEl.classList.add('active', product);
  updateTopbar(product, view);
  if(product==='hub' && view==='calendar') buildHubCalendar();
  if(product==='hub' && view==='queue') buildFullPostList();
  if(product==='hub' && view==='templates') buildHubTemplates();
  if(product==='scholars' && view==='attendance') buildAttCalendar();
}

