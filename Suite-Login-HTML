  var el = document.getElementById("calendarContent");
  if (!el || !data) return;

  var parts = [];

  parts.push('<div style="margin-bottom:20px;padding:16px 20px;background:#f9fafb;border-radius:12px;border-left:4px solid ' + data.color + '">');
  parts.push('<div style="font-size:13px;font-weight:700;color:#111827;margin-bottom:4px;">' + data.title + ' &mdash; ' + data.dates + '</div>');
  parts.push('<div style="font-size:12px;color:#6b7280;line-height:1.6;">' + data.goal + '</div>');
